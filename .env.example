BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_REST=https://fapi.binance.com
BINANCE_WS=wss://fstream.binance.com/stream
MODE=paper
LIVE_TRADING_ENABLED=false
RISK_PER_TRADE=0.0025
MAX_DAILY_LOSS=0.02
MAX_SPREAD_BPS=5

# Governance: ORDERFLOW_BASELINE_V5 is frozen and locked to NO LIVE TRADING.
# This is a code-level rule in app/orchestrator.py and app/main.py; the env
# variable is a redundant explicit declaration for human operators.
ORDERFLOW_BASELINE_V5_NO_LIVE_TRADE=true
